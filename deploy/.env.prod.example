# Скопируйте в deploy/.env.prod и заполните. Файл с секретами в git не попадает.
DOMAIN=creative.example.com
# Сгенерировать: openssl rand -hex 24
POSTGRES_PASSWORD=
# Сгенерировать: openssl rand -hex 32
APP_JWT_SECRET=
# Кнопки входа за тестовых пользователей без пароля: список пользователей виден всем — по умолчанию выключено
APP_DEMO_MODE=false
# Внешний HTTPS-порт, если 443 на сервере занят (тогда сайт — https://домен:8443)
# PUBLIC_HTTPS_PORT=8443
