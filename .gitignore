.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key

# ---------- Python (backend) ----------
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.hypothesis/
.tox/

# Загруженные файлы и временные части загрузок
backend/data/
backend/tests/.uploads/
*.part

# ---------- Node (frontend, e2e) ----------
node_modules/
dist/
coverage/
*.tsbuildinfo
.vite/
.eslintcache
npm-debug.log*

# ---------- Playwright ----------
e2e/test-results/
e2e/playwright-report/
e2e/blob-report/
